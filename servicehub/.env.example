# Replace both examples with the same strong random URL-safe password.
POSTGRES_PASSWORD=replace-with-a-strong-random-url-safe-password
DATABASE_URL=postgres://servicehub:replace-with-a-strong-random-url-safe-password@db:5432/servicehub

# Used to create the first administrator if one does not exist. Remove the
# values from .env after the first successful deployment.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

APP_PORT=4000
SESSION_DAYS=30
DB_POOL_MAX=10
TRUST_PROXY=false
CORS_ORIGIN=
SEED_SAMPLE_CATALOG=false

# PostgreSQL connection used by the API and migration scripts.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servicehub

# API port and browser origins allowed to call it directly.
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Session lifetime in days.
SESSION_DAYS=30

# Optional one-time administrator bootstrap. Use at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

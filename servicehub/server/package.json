{
  "name": "servicehub-server",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL-backed REST API for the ServiceHub React app",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:production": "node src/start-production.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "reset": "node src/migrate.js --reset && node src/seed.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.13.1"
  }
}

{
  "name": "servicehub",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "start:production": "npm --prefix server run start:production",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "db:migrate": "npm --prefix server run migrate",
    "db:seed": "npm --prefix server run seed",
    "db:reset": "npm --prefix server run reset"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
